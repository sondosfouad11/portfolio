# Copy to .env for local testing. On Vercel, add these in Project → Settings → Environment Variables.
# Never commit real values. Only variables starting with VITE_ reach the browser.

# --- Email (required for the contact form) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=sondoslasheen@gmail.com
# Leave empty to use Resend's test sender "onboarding@resend.dev"
CONTACT_FROM_EMAIL=

# --- Optional: Cloudflare Turnstile spam check (both keys, or neither) ---
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# --- Optional Phase 2: save messages in Supabase + /admin page ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
# Optional: a long random string to sign the admin cookie (defaults to one derived from ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=

# --- Optional: send the form to another service (e.g. Formspree) instead of /api/contact ---
VITE_FORM_ENDPOINT=

# --- Local testing only: accept the form without sending an email ---
CONTACT_DRY_RUN=
